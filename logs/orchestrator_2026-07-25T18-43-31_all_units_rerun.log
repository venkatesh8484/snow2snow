CREATE OR REPLACE TRANSIENT TABLE STAGING.Sq_Src_LinksCSVFile (
    FIELD1 VARCHAR(25), FIELD2 VARCHAR(7),  FIELD3 VARCHAR(30), FIELD4 VARCHAR(5),
    FIELD5 VARCHAR(7),  FIELD6 VARCHAR(7),  FIELD7 VARCHAR(4),  FIELD8 VARCHAR(3),
    FIELD9 VARCHAR(2),  FIELD10 VARCHAR(2), FIELD11 VARCHAR(3), FIELD12 VARCHAR(4),
    FIELD13 VARCHAR(1), FIELD14 VARCHAR(7), FIELD15 VARCHAR(4), FIELD16 VARCHAR(2),
