WITH old_links AS (
    SELECT
        LINK_STN_CD,
        IN_ORIGN_STN_CD,
        IN_ALN_CD,
        IN_FLT_NO,
        RPAD(TO_CHAR(IN_FLT_NO),4,' ') AS IN_FLT_NO_STR,
        IN_FLT_SFX_CD,
        IN_DEP_GMT_FLT_DT,
        TO_CHAR(IN_DEP_GMT_FLT_DT,'DDMONYY') AS IN_DEP_DT_STR,
        IN_ARR_GMT_FLT_DT,
        IN_ARR_GMT_FLT_TM,
        IN_PAX_TML_CD,
        IN_GROUND_ACY_CD,
        IN_SERVICE_TYP,
        IN_FLT_LEG_SEQ_NO,
        OUT_DESTN_STN_CD,
        OUT_ALN_CD,
        OUT_FLT_NO,
        OUT_FLT_SFX_CD,
        OUT_DEP_GMT_FLT_DT,
        OUT_DEP_GMT_FLT_TM,
        OUT_ARR_GMT_FLT_DT,
        OUT_PAX_TML_CD,
        OUT_GROUND_ACY_CD,
        OUT_SERVICE_TYP,
