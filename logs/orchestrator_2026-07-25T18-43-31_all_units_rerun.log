          TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>','DDMONYY')
      AND TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>','DDMONYY')
),
new_links AS (
    SELECT
        LINK_STN_CD,
        IN_ORIGN_STN_CD,
        IN_ALN_CD,
        IN_FLT_NO,
        TRIM(IN_FLT_SFX_CD) AS IN_FLT_SFX_CD,
        IN_DEP_GMT_FLT_DT,
        IN_ARR_GMT_FLT_DT,
        IN_ARR_GMT_FLT_TM,
        IN_PAX_TML_CD,
        IN_GROUND_ACY_CD,
        IN_SERVICE_TYP,
        OUT_DESTN_STN_CD,
        OUT_ALN_CD,
        OUT_FLT_NO,
        TRIM(OUT_FLT_SFX_CD) AS OUT_FLT_SFX_CD,
        OUT_DEP_GMT_FLT_DT,
        OUT_DEP_GMT_FLT_TM,
        OUT_ARR_GMT_FLT_DT,
        OUT_PAX_TML_CD,
        OUT_GROUND_ACY_CD,
        OUT_SERVICE_TYP,
        AIRCRAFT_OWNER_CD,
        CARRIER_AC_TYP,
        MIDNIGHT_QTY,
        BUFFER_DUR,
