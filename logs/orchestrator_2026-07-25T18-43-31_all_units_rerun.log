-- [KEEP] SNZ-01 line 18: `<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>`
--   template tag preserved verbatim (not a fix; preserved per SNZ-01).
UPDATE BASE.FLT_FOLDERLINKS tgt
SET
    LINK_EXPIRY_DT  = src.LINK_EXPIRY_DT,
    CURRENT_REC_IND = src.CURRENT_REC_IND
FROM (
    SELECT
        OLD_LINK_STATION_CD       AS LINK_STATION_CD,
        OLD_IN_ORIGN_STATION_CD   AS IN_ORIGN_STATION_CD,
        OLD_IN_ALN_CD         AS IN_ALN_CD,
        OLD_IN_FLIGHT_NO         AS IN_FLIGHT_NO,
        OLD_IN_FLIGHT_SFX_CD     AS IN_FLIGHT_SFX_CD,
        OLD_IN_DEP_FLIGHT_DT AS IN_DEP_FLIGHT_DT,  -- TODO(SME): DEF-07 — confirm intended column name is IN_DEP_FLIGHT_DT (was IN_DEP_GMTFLIGHT_FLIGHT_DT in buggy input)
        OLD_LINK_EFFECTIVE_DT AS LINK_EFFECTIVE_DT,
        IFF(
            TO_CHAR(OLD_LINK_EXPIRY_DT,'YYYYMMDD') <> '20501231',  -- TODO(SME): SEM-06/SEM-08 — confirm intended NULL handling when OLD_LINK_EXPIRY_DT is NULL (NULL routes to the DATEADD else-branch)
            OLD_LINK_EXPIRY_DT,
            DATEADD(DAY,-1,TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>','DDMONYY'))  -- TODO(SME): SEM-06/DTX-09 — confirm injected Current_date is in DDMONYY form
        ) AS LINK_EXPIRY_DT,
        IFF(ACTION_CODE = 'U','Y','N') AS CURRENT_REC_IND
    FROM STAGING.Rtr_DirectFlowOfLinksRecords
    WHERE ACTION_CODE IN ('U','B')
) src
WHERE tgt.LINK_STATION_CD       = src.LINK_STATION_CD  -- TODO(SME): SEM-03 — verify key cols are not CHAR(n); wrap in RTRIM if so
  AND tgt.IN_ORIGN_STATION_CD   = src.IN_ORIGN_STATION_CD
  AND tgt.IN_ALN_CD         = src.IN_ALN_CD
  AND tgt.IN_FLIGHT_NO         = src.IN_FLIGHT_NO
  AND tgt.IN_FLIGHT_SFX_CD     = src.IN_FLIGHT_SFX_CD
  AND tgt.IN_DEP_FLIGHT_DT = src.IN_DEP_FLIGHT_DT
  AND tgt.LINK_EFFECTIVE_DT = src.LINK_EFFECTIVE_DT
  AND NOT EXISTS (
        SELECT 1
        FROM BASE.FLIGHT_FOLDERLINKS x  -- TODO(SME): DEF-07 — confirm FLIGHT_FOLDERLINKS is a distinct guard table, not a typo for the FLT_FOLDERLINKS update target
        WHERE x.LINK_STATION_CD       = tgt.LINK_STATION_CD
          AND x.IN_ORIGN_STATION_CD   = tgt.IN_ORIGN_STATION_CD
          AND x.IN_ALN_CD         = tgt.IN_ALN_CD
          AND x.IN_FLIGHT_NO         = tgt.IN_FLIGHT_NO
          AND x.IN_FLIGHT_SFX_CD     = tgt.IN_FLIGHT_SFX_CD
          AND x.IN_DEP_FLIGHT_DT = tgt.IN_DEP_FLIGHT_DT
          AND x.LINK_EFFECTIVE_DT = tgt.LINK_EFFECTIVE_DT
          AND x.LINK_EXPIRY_DT    = src.LINK_EXPIRY_DT
          AND x.CURRENT_REC_IND   = src.CURRENT_REC_IND
  );

