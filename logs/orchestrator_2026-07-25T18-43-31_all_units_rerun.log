-- 2. Load raw CSV file into staging
PUT file://<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFile_DIR %>
    @<% ctx.env.LANDING_STAGE %>
    OVERWRITE = TRUE AUTO_COMPRESS = FALSE;

COPY INTO STAGING.Sq_Src_LinksCSVFile
FROM @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFileName %>
FILE_FORMAT = (TYPE='CSV', FIELD_DELIMITER=',', ERROR_ON_COLUMN_COUNT_MISMATCH=FALSE);

REMOVE @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFileName %>;

-- 3. Extract header record into a single CSV output file
COPY INTO @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_OutputFileName %>
FROM (
    SELECT
        FIELD2 AS CURRENT_DATE,
        FIELD3 AS SCHEDULE_NAME,
        FIELD5 AS PERIOD_START,
        FIELD6 AS PERIOD_END
    FROM STAGING.Sq_Src_LinksCSVFile
    WHERE FIELD1 = 'LINKS'
)
FILE_FORMAT = (
    TYPE='CSV', ENCODING='WINDOWS1252', FIELD_DELIMITER=',', COMPRESSION=NONE
)
SINGLE = TRUE
OVERWRITE = TRUE;

GET @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_OutputFileName %>
    file://<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_OutputFileName_DIR %>
    OVERWRITE = TRUE;

REMOVE @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_OutputFileName %>;

-- 4. Insert detailed link records into WRK_FLT_SCHED_LINKS
-- TODO(SME) SEM-05: Target STAGING.WRK_FLT_SCHED_LINKS DDL not supplied in this script;
--   SET vs MULTISET nature unknown. INSERT OVERWRITE truncates first, so dedup is
--   not in play here — flagged for awareness only, not a blocking gate.
-- TODO(SME) SEM-03/DTX-03: Target column types (CHAR(n) vs VARCHAR) unknown.
--   Teradata blank-pads CHAR(n) and ignores trailing spaces in `=`; Snowflake does
--   not pad. Affects downstream joins/anti-joins against this target. Confirm DDL.
INSERT OVERWRITE INTO STAGING.WRK_FLT_SCHED_LINKS (
    LINK_STN_CD, IN_ORIGN_STN_CD, IN_ALN_CD, IN_FLT_NO, IN_FLT_SFX_CD,
    IN_DEP_GMT_FLT_DT, IN_ARR_GMT_FLT_DT, IN_ARR_GMT_FLT_TM, IN_PAX_TML_CD,
    IN_GROUND_ACY_CD, IN_SERVICE_TYP, OUT_DESTN_STN_CD, OUT_ALN_CD,
    OUT_FLT_NO, OUT_FLT_SFX_CD, OUT_DEP_GMT_FLT_DT, OUT_DEP_GMT_FLT_TM,
    OUT_ARR_GMT_FLT_DT, OUT_PAX_TML_CD, OUT_GROUND_ACY_CD, OUT_SERVICE_TYP,
    AIRCRAFT_OWNER_CD, CARRIER_AC_TYP, MIDNIGHT_QTY, BUFFER_DUR,
    STD_WORKING_DUR, TOW_TIME_DUR, FIXED_LINK_RSN_TXT
)
SELECT
    SUBSTR(FIELD2,1,3),
    FIELD25,
    SUBSTR(FIELD3,1,3),
    SUBSTR(FIELD4,1,4),
    -- TODO(SME) SEM-08: IFF(... IS NULL,' ',...) substitutes a single space for NULL,
    --   not '' or NULL. Confirm ' ' vs '' vs NULL intent for IN_FLT_SFX_CD.
    IFF(SUBSTR(FIELD5,1,1) IS NULL,' ',SUBSTR(FIELD5,1,1)),
    FIELD26,
    FIELD6,
    -- TODO(SME) SEM-04: TO_TIMESTAMP(...,'DDMONYYHH24MI') yields TIMESTAMP_NTZ by
    --   default; target col IN_ARR_GMT_FLT_TM is GMT-named. Confirm NTZ vs TZ/LTZ intent.
    -- TODO(SME) SEM-06: FIELD6 || FIELD7 — Snowflake || returns NULL if any operand is
    --   NULL; no NULL guard here unlike the suffix fields. Confirm NULL handling.
    -- TODO(SME) OBS-01: 'DDMONYYHH24MI' mask is locale-dependent (MON case-sensitive).
    --   Confirm CSV date format and locale.
    TO_TIMESTAMP(FIELD6 || FIELD7,'DDMONYYHH24MI'),
    FIELD9,
    FIELD18,
    FIELD20,
    FIELD27,
    FIELD11,
    FIELD12,
    -- TODO(SME) SEM-08: IFF(... IS NULL,' ',...) substitutes a single space for NULL,
    --   not '' or NULL. Confirm ' ' vs '' vs NULL intent for OUT_FLT_SFX_CD.
    IFF(SUBSTR(FIELD13,1,1) IS NULL,' ',SUBSTR(FIELD13,1,1)),
    FIELD14,
    -- TODO(SME) SEM-04: TO_TIMESTAMP(...,'DDMONYYHH24MI') yields TIMESTAMP_NTZ by
    --   default; target col OUT_DEP_GMT_FLT_TM is GMT-named. Confirm NTZ vs TZ/LTZ intent.
    -- TODO(SME) SEM-06: FIELD14 || FIELD15 — Snowflake || returns NULL if any operand
    --   is NULL; no NULL guard here unlike the suffix fields. Confirm NULL handling.
    -- TODO(SME) OBS-01: 'DDMONYYHH24MI' mask is locale-dependent (MON case-sensitive).
    --   Confirm CSV date format and locale.
    TO_TIMESTAMP(FIELD14 || FIELD15,'DDMONYYHH24MI'),
    FIELD28,
    FIELD10,
    FIELD19,
    FIELD21,
    FIELD22,
    SUBSTR(FIELD1,1,3),
    FIELD8,
    FIELD16,
    FIELD17,
    FIELD23,
    FIELD24
FROM STAGING.Sq_Src_LinksCSVFile
WHERE FIELD1 NOT IN ('LINKS','TRAILER');

