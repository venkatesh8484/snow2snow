    best_usg.ex_to_pme_dc_no        AS ex_to_pme_dc_no,
    best_usg.ex_to_pme_dc_id        AS ex_to_pme_dc_id,
    best_usg.ex_to_dc_typ_cd        AS ex_to_dc_typ_cd,
