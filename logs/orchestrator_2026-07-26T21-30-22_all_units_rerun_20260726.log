------------------------------------------------------------------------
-- FIX LOG (issues repaired during remediation)
-- [DEF-07] line 12: subquery alias `IN_DEP_GMTFLIGHT_FLIGHT_DT` -> `IN_DEP_FLIGHT_DT`
--   to match the outer reference `src.IN_DEP_FLIGHT_DT` (line 29) and the
--   NOT EXISTS guard `tgt.IN_DEP_FLIGHT_DT` (line 39). The converter's
--   find/replace drift (doubled `FLIGHT` + `GMT` infix) produced a runtime
--   `invalid identifier 'SRC.IN_DEP_FLIGHT_DT'`. Outer references left untouched
--   (minimal diff = 1 token).
-- [KEEP] SNZ-01 line 14: template tag `<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>`
--   preserved verbatim (resolved by the orchestrator at run time, not by Snowflake).
-- [TODO(SME)] DEF-07 line 1 vs 32: table-name mismatch between UPDATE target
--   `BASE.FLT_FOLDERLINKS` (tgt) and NOT EXISTS guard `BASE.FLIGHT_FOLDERLINKS`
--   (x). Per DEF-07 no-guess policy, neither table is renamed without ground
--   truth. Confirm whether the anti-join should target the same table or a
--   distinct `FLIGHT_FOLDERLINKS` table.
-- [TODO(SME)] SEM-03 lines 29-43: CHAR(n) padding drift on the 8-key join and
--   8-key anti-join. If any `*_CD`/`*_NO`/`*_DT` key is CHAR(n), Teradata
--   blank-pads and ignores trailing spaces in `=`; Snowflake does not. Needs
--   DDL for BASE.FLT_FOLDERLINKS and STAGING.Rtr_DirectFlowOfLinksRecords.
-- [TODO(SME)] SEM-06/DTX-09 line 14: locale-dependent date mask `'DDMONYY'` in
--   `TO_DATE('<% ... %>','DDMONYY')`. `MON` is case-sensitive and
--   locale-dependent in Snowflake; confirm the orchestrator's date format and
--   session locale match the mask.
-- [TODO(SME)] SEM-06/SEM-08 lines 14-18: NULL-handling asymmetry in the IFF
--   expiry expression. If `OLD_LINK_EXPIRY_DT` is NULL, `TO_CHAR(NULL, ...)`
--   returns NULL, `NULL <> '20501231'` is NULL (not TRUE), so IFF takes the
--   FALSE branch and sets `LINK_EXPIRY_DT = Current_date - 1`. Confirm this
--   NULL-fallthrough is intended.
-- [TODO(SME)] SEM-10 lines 29-35: join-key direction. The `OLD_*` prefix on the
--   staging source columns suggests pre-change values matched to the target;
--   confirm `OLD_IN_DEP_FLIGHT_DT` -> `IN_DEP_FLIGHT_DT` (after the DEF-07 fix)
--   is the intended key mapping.

UPDATE BASE.FLT_FOLDERLINKS tgt
SET
    LINK_EXPIRY_DT  = src.LINK_EXPIRY_DT,
    CURRENT_REC_IND = src.CURRENT_REC_IND
FROM (
    SELECT
        OLD_LINK_STATION_CD       AS LINK_STATION_CD,
        OLD_IN_ORIGN_STATION_CD   AS IN_ORIGN_STATION_CD,
        OLD_IN_ALN_CD         AS IN_ALN_CD,
        OLD_IN_FLIGHT_NO         AS IN_FLIGHT_NO,
        OLD_IN_FLIGHT_SFX_CD     AS IN_FLIGHT_SFX_CD,
        OLD_IN_DEP_FLIGHT_DT AS IN_DEP_FLIGHT_DT, -- TODO(SME): DEF-07 alias repaired (was IN_DEP_GMTFLIGHT_FLIGHT_DT); SEM-10 confirm OLD_IN_DEP_FLIGHT_DT -> IN_DEP_FLIGHT_DT is the intended key mapping
        OLD_LINK_EFFECTIVE_DT AS LINK_EFFECTIVE_DT,
        IFF(
            TO_CHAR(OLD_LINK_EXPIRY_DT,'YYYYMMDD') <> '20501231',
            OLD_LINK_EXPIRY_DT,
            DATEADD(DAY,-1,TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>','DDMONYY')) -- TODO(SME): SEM-06/DTX-09 locale-dependent 'DDMONYY' mask; SEM-06/SEM-08 NULL OLD_LINK_EXPIRY_DT falls through to Current_date-1
        ) AS LINK_EXPIRY_DT,
        IFF(ACTION_CODE = 'U','Y','N') AS CURRENT_REC_IND
    FROM STAGING.Rtr_DirectFlowOfLinksRecords
    WHERE ACTION_CODE IN ('U','B')
) src
WHERE tgt.LINK_STATION_CD       = src.LINK_STATION_CD
  AND tgt.IN_ORIGN_STATION_CD   = src.IN_ORIGN_STATION_CD
  AND tgt.IN_ALN_CD         = src.IN_ALN_CD
  AND tgt.IN_FLIGHT_NO         = src.IN_FLIGHT_NO
  AND tgt.IN_FLIGHT_SFX_CD     = src.IN_FLIGHT_SFX_CD
  AND tgt.IN_DEP_FLIGHT_DT = src.IN_DEP_FLIGHT_DT
  AND tgt.LINK_EFFECTIVE_DT = src.LINK_EFFECTIVE_DT
  AND NOT EXISTS (
        SELECT 1
        FROM BASE.FLIGHT_FOLDERLINKS x -- TODO(SME): DEF-07 table-name mismatch vs UPDATE target BASE.FLT_FOLDERLINKS; SEM-03 CHAR(n) padding drift on these 8 anti-join keys
        WHERE x.LINK_STATION_CD       = tgt.LINK_STATION_CD
          AND x.IN_ORIGN_STATION_CD   = tgt.IN_ORIGN_STATION_CD
          AND x.IN_ALN_CD         = tgt.IN_ALN_CD
          AND x.IN_FLIGHT_NO         = tgt.IN_FLIGHT_NO
          AND x.IN_FLIGHT_SFX_CD     = tgt.IN_FLIGHT_SFX_CD
          AND x.IN_DEP_FLIGHT_DT = tgt.IN_DEP_FLIGHT_DT
          AND x.LINK_EFFECTIVE_DT = tgt.LINK_EFFECTIVE_DT
          AND x.LINK_EXPIRY_DT    = src.LINK_EXPIRY_DT
          AND x.CURRENT_REC_IND   = src.CURRENT_REC_IND
  );

