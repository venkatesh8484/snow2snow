);

-- 2. Load raw CSV file into staging
PUT file://<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFile_DIR %>
    @<% ctx.env.LANDING_STAGE %>
    OVERWRITE = TRUE AUTO_COMPRESS = FALSE;

COPY INTO STAGING.Sq_Src_LinksCSVFile
FROM @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFileName %>
FILE_FORMAT = (TYPE='CSV', FIELD_DELIMITER=',', ERROR_ON_COLUMN_COUNT_MISMATCH=FALSE);

REMOVE @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_InputFileName %>;

-- 3. Extract header record into a single CSV output file
COPY INTO @<% ctx.env.LANDING_STAGE %>/<% ctx.env.S_vwxxxx_MapLinksRecordsToOracle_OutputFileName %>
FROM (
    SELECT
        FIELD2 AS CURRENT_DATE,
        FIELD3 AS SCHEDULE_NAME,
        FIELD5 AS PERIOD_START,
        FIELD6 AS PERIOD_END
    FROM STAGING.Sq_Src_LinksCSVFile
    WHERE FIELD1 = 'LINKS'
)
FILE_FORMAT = (
