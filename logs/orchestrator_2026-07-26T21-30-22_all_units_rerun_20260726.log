CREATE OR REPLACE TRANSIENT TABLE staging.Lkp_InFltLegSeqNo AS :: Stmt 1: inbound flight-leg lookup CTAS, deduped by opg_flt_leg_id DESC
QUALIFY ROW_NUMBER() OVER (
            PARTITION BY
                ssfl.operating_airline_cd,
                ssfl.operating_flt_no,
                ssfl.operating_sfx_cd,
                ssfl.gmt_sched_arr_tm,
                ssfl.dep_stn_cd,
                ssfl.arr_stn_cd
