CREATE OR REPLACE TRANSIENT TABLE STAGING.Rtr_DirectFlowOfLinksRecords AS :: Stmt 2: old-vs-new link compare CTAS
FROM old_links o
    FULL OUTER JOIN new_links n :: FULL OUTER JOIN so added/removed/modified links are all visible
        ) AS OLD_concat_record :: OLD fingerprint: concatenated link attributes for change detection
        ) AS NEW_concat_record :: NEW fingerprint: RTRIM applied on NEW side (SEM-03 asymmetry)
