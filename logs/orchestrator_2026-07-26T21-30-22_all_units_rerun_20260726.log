CREATE OR REPLACE TRANSIENT TABLE staging.Lkp_InFltLegSeqNo AS
WITH Lkp_InFltLegSeqNo AS (

    SELECT
        FLT_LEG_SEQ_NO,
        OPERATING_AIRLINE_CD,
        OPERATING_FLT_NO,
        OPERATING_SFX_CD,
        GMT_SCHED_ARR_TM,
        DEP_STN_CD,
        ARR_STN_CD
    FROM (
        SELECT
            ssfl.opg_flt_leg_id          AS FLT_LEG_SEQ_NO,
            ssfl.operating_airline_cd    AS OPERATING_AIRLINE_CD,
            ssfl.operating_flt_no        AS OPERATING_FLT_NO,
            ssfl.operating_sfx_cd        AS OPERATING_SFX_CD,
            ssfl.gmt_sched_arr_tm        AS GMT_SCHED_ARR_TM,
            ssfl.dep_stn_cd              AS DEP_STN_CD,
            ssfl.arr_stn_cd              AS ARR_STN_CD
        FROM BASE.schedule_sales_flt_leg ssfl
        JOIN BASE.schedule_sales_mkg_leg ssml
          ON ssfl.operating_airline_cd = ssml.operating_airline_cd
         AND ssfl.operating_flt_no     = ssml.operating_flt_no
         AND ssfl.operating_sfx_cd     = ssml.operating_sfx_cd
         AND ssfl.sched_dep_dt         = ssml.sched_dep_dt
         AND ssfl.dep_stn_cd           = ssml.dep_stn_cd
         AND ssfl.arr_stn_cd           = ssml.arr_stn_cd
        WHERE ssml.marketing_airline_cd = 'BA'
          AND ssfl.effective_dt BETWEEN ssml.effective_dt AND ssml.expiry_dt
          AND ssfl.current_rec_ind = 'Y'
        QUALIFY ROW_NUMBER() OVER (
            PARTITION BY
                ssfl.operating_airline_cd,
                ssfl.operating_flt_no,
                ssfl.operating_sfx_cd,
                ssfl.gmt_sched_arr_tm,
                ssfl.dep_stn_cd,
                ssfl.arr_stn_cd
            ORDER BY ssfl.opg_flt_leg_id DESC
        ) = 1
    )
)
SELECT *
FROM Lkp_InFltLegSeqNo;
CREATE OR REPLACE TRANSIENT TABLE STAGING.Rtr_DirectFlowOfLinksRecords AS
WITH old_links AS (
    SELECT
        LINK_STN_CD,
        IN_ORIGN_STN_CD,
        IN_ALN_CD,
        IN_FLT_NO,
        RPAD(TO_CHAR(IN_FLT_NO),4,' ') AS IN_FLT_NO_STR,
        IN_FLT_SFX_CD,
        IN_DEP_GMT_FLT_DT,
        TO_CHAR(IN_DEP_GMT_FLT_DT,'DDMONYY') AS IN_DEP_DT_STR,
        IN_ARR_GMT_FLT_DT,
        IN_ARR_GMT_FLT_TM,
        IN_PAX_TML_CD,
        IN_GROUND_ACY_CD,
        IN_SERVICE_TYP,
        IN_FLT_LEG_SEQ_NO,
        OUT_DESTN_STN_CD,
        OUT_ALN_CD,
        OUT_FLT_NO,
        OUT_FLT_SFX_CD,
        OUT_DEP_GMT_FLT_DT,
        OUT_DEP_GMT_FLT_TM,
        OUT_ARR_GMT_FLT_DT,
        OUT_PAX_TML_CD,
        OUT_GROUND_ACY_CD,
        OUT_SERVICE_TYP,
        OUT_FLT_LEG_SEQ_NO,
        AIRCRAFT_OWNER_CD,
        CARRIER_AC_TYP,
        MIDNIGHT_QTY,
        BUFFER_DUR,
        STD_WORKING_DUR,
        TOW_TIME_DUR,
        FIXED_LINK_RSN_TXT,
        LINK_EFFECTIVE_DT,
        LINK_EXPIRY_DT,
        CURRENT_REC_IND
    FROM BASE.FLT_SCHEDULE_LINKS
    WHERE CURRENT_REC_IND = 'Y'
      AND IN_DEP_GMT_FLT_DT BETWEEN
          TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>','DDMONYY')
      AND TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>','DDMONYY')
),
new_links AS (
    SELECT
        LINK_STN_CD,
        IN_ORIGN_STN_CD,
        IN_ALN_CD,
        IN_FLT_NO,
        TRIM(IN_FLT_SFX_CD) AS IN_FLT_SFX_CD,
        IN_DEP_GMT_FLT_DT,
        IN_ARR_GMT_FLT_DT,
        IN_ARR_GMT_FLT_TM,
        IN_PAX_TML_CD,
        IN_GROUND_ACY_CD,
        IN_SERVICE_TYP,
        OUT_DESTN_STN_CD,
        OUT_ALN_CD,
        OUT_FLT_NO,
        TRIM(OUT_FLT_SFX_CD) AS OUT_FLT_SFX_CD,
        OUT_DEP_GMT_FLT_DT,
        OUT_DEP_GMT_FLT_TM,
        OUT_ARR_GMT_FLT_DT,
        OUT_PAX_TML_CD,
        OUT_GROUND_ACY_CD,
        OUT_SERVICE_TYP,
        AIRCRAFT_OWNER_CD,
        CARRIER_AC_TYP,
        MIDNIGHT_QTY,
        BUFFER_DUR,
        STD_WORKING_DUR,
        TOW_TIME_DUR,
        FIXED_LINK_RSN_TXT
    FROM STAGING.WRK_FLT_SCHED_LINKS
),
joined AS (
    SELECT
        /* SFX-17: explicit OLD_-prefixed columns from old_links (o) */
        o.LINK_STN_CD            AS OLD_LINK_STN_CD,
        o.IN_ORIGN_STN_CD        AS OLD_IN_ORIGN_STN_CD,
        o.IN_ALN_CD              AS OLD_IN_ALN_CD,
        o.IN_FLT_NO              AS OLD_IN_FLT_NO,
        o.IN_FLT_NO_STR          AS OLD_IN_FLT_NO_STR,
        o.IN_FLT_SFX_CD          AS OLD_IN_FLT_SFX_CD,
        o.IN_DEP_GMT_FLT_DT      AS OLD_IN_DEP_GMT_FLT_DT,
        o.IN_DEP_DT_STR          AS OLD_IN_DEP_DT_STR,
        o.IN_ARR_GMT_FLT_DT      AS OLD_IN_ARR_GMT_FLT_DT,
        o.IN_ARR_GMT_FLT_TM      AS OLD_IN_ARR_GMT_FLT_TM,
        o.IN_PAX_TML_CD          AS OLD_IN_PAX_TML_CD,
        o.IN_GROUND_ACY_CD       AS OLD_IN_GROUND_ACY_CD,
        o.IN_SERVICE_TYP         AS OLD_IN_SERVICE_TYP,
        o.IN_FLT_LEG_SEQ_NO      AS OLD_IN_FLT_LEG_SEQ_NO,
        o.OUT_DESTN_STN_CD       AS OLD_OUT_DESTN_STN_CD,
        o.OUT_ALN_CD             AS OLD_OUT_ALN_CD,
        o.OUT_FLT_NO             AS OLD_OUT_FLT_NO,
        o.OUT_FLT_SFX_CD         AS OLD_OUT_FLT_SFX_CD,
        o.OUT_DEP_GMT_FLT_DT     AS OLD_OUT_DEP_GMT_FLT_DT,
        o.OUT_DEP_GMT_FLT_TM     AS OLD_OUT_DEP_GMT_FLT_TM,
        o.OUT_ARR_GMT_FLT_DT     AS OLD_OUT_ARR_GMT_FLT_DT,
        o.OUT_PAX_TML_CD         AS OLD_OUT_PAX_TML_CD,
        o.OUT_GROUND_ACY_CD      AS OLD_OUT_GROUND_ACY_CD,
        o.OUT_SERVICE_TYP        AS OLD_OUT_SERVICE_TYP,
        o.OUT_FLT_LEG_SEQ_NO     AS OLD_OUT_FLT_LEG_SEQ_NO,
        o.AIRCRAFT_OWNER_CD      AS OLD_AIRCRAFT_OWNER_CD,
        o.CARRIER_AC_TYP        AS OLD_CARRIER_AC_TYP,
        o.MIDNIGHT_QTY           AS OLD_MIDNIGHT_QTY,
        o.BUFFER_DUR             AS OLD_BUFFER_DUR,
        o.STD_WORKING_DUR        AS OLD_STD_WORKING_DUR,
        o.TOW_TIME_DUR           AS OLD_TOW_TIME_DUR,
        o.FIXED_LINK_RSN_TXT     AS OLD_FIXED_LINK_RSN_TXT,
        o.LINK_EFFECTIVE_DT      AS OLD_LINK_EFFECTIVE_DT,
        o.LINK_EXPIRY_DT         AS OLD_LINK_EXPIRY_DT,
        o.CURRENT_REC_IND        AS OLD_CURRENT_REC_IND,

        /* SFX-17: explicit NEW_-prefixed columns from new_links (n) */
        n.LINK_STN_CD            AS NEW_LINK_STN_CD,
        n.IN_ORIGN_STN_CD        AS NEW_IN_ORIGN_STN_CD,
        n.IN_ALN_CD              AS NEW_IN_ALN_CD,
        n.IN_FLT_NO              AS NEW_IN_FLT_NO,
        n.IN_FLT_SFX_CD          AS NEW_IN_FLT_SFX_CD,
        n.IN_DEP_GMT_FLT_DT      AS NEW_IN_DEP_GMT_FLT_DT,
        n.IN_ARR_GMT_FLT_DT      AS NEW_IN_ARR_GMT_FLT_DT,
        n.IN_ARR_GMT_FLT_TM      AS NEW_IN_ARR_GMT_FLT_TM,
        n.IN_PAX_TML_CD          AS NEW_IN_PAX_TML_CD,
        n.IN_GROUND_ACY_CD       AS NEW_IN_GROUND_ACY_CD,
        n.IN_SERVICE_TYP         AS NEW_IN_SERVICE_TYP,
        n.OUT_DESTN_STN_CD       AS NEW_OUT_DESTN_STN_CD,
        n.OUT_ALN_CD             AS NEW_OUT_ALN_CD,
        n.OUT_FLT_NO             AS NEW_OUT_FLT_NO,
        n.OUT_FLT_SFX_CD         AS NEW_OUT_FLT_SFX_CD,
        n.OUT_DEP_GMT_FLT_DT     AS NEW_OUT_DEP_GMT_FLT_DT,
        n.OUT_DEP_GMT_FLT_TM     AS NEW_OUT_DEP_GMT_FLT_TM,
        n.OUT_ARR_GMT_FLT_DT     AS NEW_OUT_ARR_GMT_FLT_DT,
        n.OUT_PAX_TML_CD         AS NEW_OUT_PAX_TML_CD,
        n.OUT_GROUND_ACY_CD      AS NEW_OUT_GROUND_ACY_CD,
        n.OUT_SERVICE_TYP        AS NEW_OUT_SERVICE_TYP,
        n.AIRCRAFT_OWNER_CD      AS NEW_AIRCRAFT_OWNER_CD,
        n.CARRIER_AC_TYP         AS NEW_CARRIER_AC_TYP,
        n.MIDNIGHT_QTY           AS NEW_MIDNIGHT_QTY,
        n.BUFFER_DUR             AS NEW_BUFFER_DUR,
        n.STD_WORKING_DUR        AS NEW_STD_WORKING_DUR,
        n.TOW_TIME_DUR           AS NEW_TOW_TIME_DUR,
        n.FIXED_LINK_RSN_TXT     AS NEW_FIXED_LINK_RSN_TXT,

        /* OLD concatenation */
        (
            IFNULL(TO_CHAR(o.IN_ARR_GMT_FLT_DT,'DDMONYY'),'') ||
            IFNULL(TO_CHAR(o.IN_ARR_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(o.IN_PAX_TML_CD,'') ||
            IFNULL(o.IN_GROUND_ACY_CD,'') ||
            IFNULL(o.IN_SERVICE_TYP,'') ||
            IFNULL(o.OUT_DESTN_STN_CD,'') ||
            IFNULL(o.OUT_ALN_CD,'') ||
            IFNULL(TO_CHAR(o.OUT_FLT_NO),'') ||
            IFNULL(o.OUT_FLT_SFX_CD,'') ||
            IFNULL(TO_CHAR(o.OUT_DEP_GMT_FLT_DT,'DDMONYY'),'') ||
            IFNULL(TO_CHAR(o.OUT_DEP_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(TO_CHAR(o.OUT_ARR_GMT_FLT_DT,'DDMONYY'),'') ||
            IFNULL(o.OUT_PAX_TML_CD,'') ||
            IFNULL(o.OUT_GROUND_ACY_CD,'') ||
            IFNULL(o.OUT_SERVICE_TYP,'') ||
            IFNULL(o.AIRCRAFT_OWNER_CD,'') ||
            IFNULL(o.CARRIER_AC_TYP,'') ||
            IFNULL(TO_CHAR(o.MIDNIGHT_QTY),'') ||
            IFNULL(TO_CHAR(o.BUFFER_DUR),'') ||
            IFNULL(TO_CHAR(o.STD_WORKING_DUR),'') ||
            IFNULL(TO_CHAR(o.TOW_TIME_DUR),'') ||
            IFNULL(o.FIXED_LINK_RSN_TXT,'')
        ) AS OLD_concat_record,

        /* NEW concatenation */
        (
            IFNULL(n.IN_ARR_GMT_FLT_DT,'') ||
            IFNULL(TO_CHAR(n.IN_ARR_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(n.IN_PAX_TML_CD,'') ||
            IFNULL(n.IN_GROUND_ACY_CD,'') ||
            IFNULL(n.IN_SERVICE_TYP,'') ||
            IFNULL(n.OUT_DESTN_STN_CD,'') ||
            IFNULL(n.OUT_ALN_CD,'') ||
            IFNULL(RTRIM(n.OUT_FLT_NO),'') ||
            IFNULL(n.OUT_FLT_SFX_CD,'') ||
            IFNULL(n.OUT_DEP_GMT_FLT_DT,'') ||
            IFNULL(TO_CHAR(n.OUT_DEP_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(n.OUT_ARR_GMT_FLT_DT,'') ||
            IFNULL(n.OUT_PAX_TML_CD,'') ||
            IFNULL(n.OUT_GROUND_ACY_CD,'') ||
            IFNULL(n.OUT_SERVICE_TYP,'') ||
            IFNULL(n.AIRCRAFT_OWNER_CD,'') ||
            IFNULL(n.CARRIER_AC_TYP,'') ||
            IFNULL(RTRIM(n.MIDNIGHT_QTY),'') ||
            IFNULL(RTRIM(n.BUFFER_DUR),'') ||
            IFNULL(RTRIM(n.STD_WORKING_DUR),'') ||
            IFNULL(RTRIM(n.TOW_TIME_DUR),'') ||
            IFNULL(n.FIXED_LINK_RSN_TXT,'')
        ) AS NEW_concat_record
    FROM old_links o
    FULL OUTER JOIN new_links n
      ON n.LINK_STN_CD     = o.LINK_STN_CD
     AND n.IN_ORIGN_STN_CD = o.IN_ORIGN_STN_CD
     AND n.IN_ALN_CD       = o.IN_ALN_CD
     AND n.IN_FLT_NO       = o.IN_FLT_NO_STR
     AND n.IN_FLT_SFX_CD   = o.IN_FLT_SFX_CD
     AND n.IN_DEP_GMT_FLT_DT = o.IN_DEP_DT_STR
),
filtered AS (
    SELECT *
    FROM joined
    WHERE
        /* Same nested IFF logic, simplified */
        (
            NEW_LINK_STN_CD IS NULL
            AND OLD_LINK_EXPIRY_DT = TO_TIMESTAMP('31122050','DDMMYYYY')
        )
        OR OLD_LINK_STN_CD IS NULL
        OR OLD_concat_record <> NEW_concat_record
        OR (
            OLD_concat_record = NEW_concat_record
            AND OLD_LINK_EXPIRY_DT <> TO_TIMESTAMP('31122050','DDMMYYYY')
        )
)
SELECT *
FROM filtered;
CREATE OR REPLACE TRANSIENT TABLE STAGING.ExpFinalyseInserts AS
-- SFX-18: restructured into a CTE chain (base -> mid -> final) so intra-SELECT
-- alias forward references become real columns in their own scope.
WITH base AS (
    SELECT
        r.*,
        inlk.FLT_LEG_SEQ_NO      AS inlk_FLT_LEG_SEQ_NO,
        outlk.FLT_LEG_SEQ_NO     AS outlk_FLT_LEG_SEQ_NO
        -- TODO(SME) DEF-07: r.Action_code is referenced downstream but is never
        -- projected by Rtr_DirectFlowOfLinksRecords. It must be added to the
        -- new_links/old_links projection (most likely source) or the reference
        -- is a converter artefact. Left as-is pending ground truth; will raise
        -- "invalid identifier 'ACTION_CODE'" at runtime until resolved.
    FROM STAGING.Rtr_DirectFlowOfLinksRecords r
    LEFT JOIN STAGING.Lkp_InFltLegSeqNo inlk
        ON inlk.OPERATING_AIRLINE_CD = r.NEW_IN_ALN_CD
       AND inlk.OPERATING_FLT_NO     = CAST(r.NEW_IN_FLT_NO AS INT)
       AND inlk.OPERATING_SFX_CD     = r.NEW_IN_FLT_SFX_CD
       AND inlk.GMT_SCHED_ARR_TM     = r.NEW_IN_ARR_GMT_FLT_TM
       AND inlk.DEP_STN_CD           = r.NEW_IN_ORIGN_STN_CD
       AND inlk.ARR_STN_CD           = r.NEW_LINK_STN_CD
    -- TODO(SME) DEF-07: STAGING.Lkp_OutFltLegSeqNo is joined but never created
    -- in this file. A CTAS mirroring Lkp_InFltLegSeqNo using GMT_SCHED_DEP_TM
    -- was likely dropped during conversion. Left as-is pending ground truth.
    LEFT JOIN STAGING.Lkp_OutFltLegSeqNo outlk
        ON outlk.OPERATING_AIRLINE_CD = r.NEW_OUT_ALN_CD
       AND outlk.OPERATING_FLT_NO     = CAST(r.NEW_OUT_FLT_NO AS INT)
       AND outlk.OPERATING_SFX_CD     = r.NEW_OUT_FLT_SFX_CD
       AND outlk.GMT_SCHED_DEP_TM     = r.NEW_OUT_DEP_GMT_FLT_TM
       AND outlk.DEP_STN_CD           = r.NEW_LINK_STN_CD
       AND outlk.ARR_STN_CD           = r.NEW_OUT_DESTN_STN_CD
    WHERE r.Action_code IN ('I','B')  -- TODO(SME) DEF-07: Action_code not projected
),
mid AS (
    SELECT
        base.*,
        /* Inbound leg sequence logic */
        IFF(
            TRIM(base.NEW_IN_ALN_CD) <> 'BA',
            0,
            IFF(
                base.Action_code = 'I',  -- TODO(SME) DEF-07: Action_code not projected
                base.inlk_FLT_LEG_SEQ_NO,
                base.OLD_IN_FLT_LEG_SEQ_NO
            )
        ) AS v_IN_FLT_LEG_SEQ_NO,

        /* Outbound leg sequence logic */
        IFF(
            TRIM(base.NEW_OUT_ALN_CD) <> 'BA',
            0,
            IFF(
                base.Action_code = 'B',  -- TODO(SME) DEF-07: Action_code not projected
                IFF(
                    (
                        base.OLD_OUT_ALN_CD = base.NEW_OUT_ALN_CD
                        AND base.OLD_OUT_FLT_NO = CAST(base.NEW_OUT_FLT_NO AS INT)
                        AND base.OLD_OUT_FLT_SFX_CD = base.NEW_OUT_FLT_SFX_CD
                        AND base.OLD_OUT_DEP_GMT_FLT_DT = TRY_TO_TIMESTAMP(base.NEW_OUT_DEP_GMT_FLT_DT,'DDMONYY')
                        AND base.OLD_LINK_STN_CD = base.NEW_LINK_STN_CD
                        AND base.OLD_OUT_DESTN_STN_CD = base.NEW_OUT_DESTN_STN_CD
                    ),
                    base.OLD_OUT_FLT_LEG_SEQ_NO,
                    base.outlk_FLT_LEG_SEQ_NO
                ),
                base.outlk_FLT_LEG_SEQ_NO
            )
        ) AS v_OUT_FLT_LEG_SEQ_NO
    FROM base
),
final AS (
    SELECT
        /* Basic inbound fields */
        mid.NEW_LINK_STN_CD,
        mid.NEW_IN_ORIGN_STN_CD,
        mid.NEW_IN_ALN_CD,
        CAST(mid.NEW_IN_FLT_NO AS INT) AS NEW_IN_FLT_NO_smallint,
        mid.NEW_IN_FLT_SFX_CD,
        TO_DATE(mid.NEW_IN_DEP_GMT_FLT_DT,'DDMONYY') AS NEW_IN_DEP_GMT_FLT_DT_date,
        TO_DATE(mid.NEW_IN_ARR_GMT_FLT_DT,'DDMONYY') AS NEW_IN_ARR_GMT_FLT_DT_date,
        mid.NEW_IN_ARR_GMT_FLT_TM AS NEW_IN_ARR_GMT_FLT_TM_date,
        mid.NEW_IN_PAX_TML_CD,
        mid.NEW_IN_GROUND_ACY_CD,
        mid.NEW_IN_SERVICE_TYP,

        /* Inbound leg sequence boundary validation (uses v_IN_FLT_LEG_SEQ_NO) */
        IFF(
            mid.v_IN_FLT_LEG_SEQ_NO IS NULL,
            IFF(
                mid.NEW_IN_ARR_GMT_FLT_DT IN (
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                ),
                mid.v_IN_FLT_LEG_SEQ_NO,
                NULL
            ),
            mid.v_IN_FLT_LEG_SEQ_NO
        ) AS NEW_IN_FLT_LEG_SEQ_NO,

        /* Outbound fields */
        mid.NEW_OUT_DESTN_STN_CD,
        mid.NEW_OUT_ALN_CD,
        CAST(mid.NEW_OUT_FLT_NO AS INT) AS NEW_OUT_FLT_NO_smallint,
        mid.NEW_OUT_FLT_SFX_CD,
        TO_DATE(mid.NEW_OUT_DEP_GMT_FLT_DT,'DDMONYY') AS NEW_OUT_DEP_GMT_FLT_DT_date,
        mid.NEW_OUT_DEP_GMT_FLT_TM AS NEW_OUT_DEP_GMT_FLT_TM_date,
        TO_DATE(mid.NEW_OUT_ARR_GMT_FLT_DT,'DDMONYY') AS NEW_OUT_ARR_GMT_FLT_DT_date,
        -- DEF-07: NEW_OUT_ARR_GMT_FLT_TM_date now sources the ARRIVAL time
        -- (was copy-pasted from NEW_OUT_DEP_GMT_FLT_TM). TODO(SME): confirm.
        mid.NEW_OUT_ARR_GMT_FLT_TM AS NEW_OUT_ARR_GMT_FLT_TM_date,
        mid.NEW_OUT_PAX_TML_CD,
        mid.NEW_OUT_GROUND_ACY_CD,
        mid.NEW_OUT_SERVICE_TYP,

        /* Outbound boundary validation (uses v_OUT_FLT_LEG_SEQ_NO) */
        IFF(
            mid.v_OUT_FLT_LEG_SEQ_NO IS NULL,
            IFF(
                mid.NEW_OUT_DEP_GMT_FLT_DT IN (
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                ),
                mid.v_OUT_FLT_LEG_SEQ_NO,
                NULL
            ),
            mid.v_OUT_FLT_LEG_SEQ_NO
        ) AS NEW_OUT_FLT_LEG_SEQ_NO,

        /* Outbound error message (uses NEW_OUT_FLT_LEG_SEQ_NO) */
        IFF(
            IFF(
                mid.v_OUT_FLT_LEG_SEQ_NO IS NULL,
                IFF(
                    mid.NEW_OUT_DEP_GMT_FLT_DT IN (
                        '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                        '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                    ),
                    mid.v_OUT_FLT_LEG_SEQ_NO,
                    NULL
                ),
                mid.v_OUT_FLT_LEG_SEQ_NO
            ) IS NULL,
            '#################### ATTENTION! The link record with the following onward flight key does not exist on FLT_SCHEDULE_SALES: OUT_ALN_CD="' ||
            mid.NEW_OUT_ALN_CD || '", OUT_FLT_NO="' || mid.NEW_OUT_FLT_NO || '", OUT_FLT_SFX_CD="' || mid.NEW_OUT_FLT_SFX_CD ||
            '", OUT_DEP_GMT_FLT_DT="' || mid.NEW_OUT_DEP_GMT_FLT_DT || '", OUT_DEP_GMT_FLT_TM="' || mid.NEW_OUT_DEP_GMT_FLT_TM ||
            '", LINK_STN_CD="' || mid.NEW_LINK_STN_CD || '", OUT_DESTN_STN_CD="' || mid.NEW_OUT_DESTN_STN_CD || '" ####################',
            'N'
        ) AS v_AbortSessionBecauseOfNULLOutFltLegSeqNo,

        /* Inbound error message (uses NEW_IN_FLT_LEG_SEQ_NO) */
        IFF(
            IFF(
                mid.v_IN_FLT_LEG_SEQ_NO IS NULL,
                IFF(
                    mid.NEW_IN_ARR_GMT_FLT_DT IN (
                        '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                        '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                    ),
                    mid.v_IN_FLT_LEG_SEQ_NO,
                    NULL
                ),
                mid.v_IN_FLT_LEG_SEQ_NO
            ) IS NULL,
            '#################### ATTENTION! The link record with the following inbound flight key does not exist on FLT_SCHEDULE_SALES: IN_ALN_CD="' ||
            mid.NEW_IN_ALN_CD || '", IN_FLT_NO="' || mid.NEW_IN_FLT_NO || '", IN_FLT_SFX_CD="' || mid.NEW_IN_FLT_SFX_CD ||
            '", IN_DEP_GMT_FLT_DT="' || mid.NEW_IN_DEP_GMT_FLT_DT || '", IN_DEP_GMT_FLT_TM="' || mid.NEW_OUT_DEP_GMT_FLT_TM ||
            '", LINK_STN_CD="' || mid.NEW_LINK_STN_CD || '", IN_DESTN_STN_CD="' || mid.NEW_OUT_DESTN_STN_CD || '" ####################',
            'N'
        ) AS v_AbortSessionBecauseOfNULLInFltLegSeqNo,
        -- TODO(SME) DEF-07: inbound error message concatenates NEW_OUT_DEP_GMT_FLT_TM
        -- (outbound dep time) for the IN_DEP_GMT_FLT_TM slot and NEW_OUT_DESTN_STN_CD
        -- for the IN_DESTN_STN_CD slot. Copy-paste from outbound block; likely should
        -- be the inbound dep time and an inbound origin/destination. Left as-is.

        /* Remaining fields */
        mid.NEW_AIRCRAFT_OWNER_CD,
        mid.NEW_CARRIER_AC_TYP,
        CAST(mid.NEW_MIDNIGHT_QTY AS INT) AS NEW_MIDNIGHT_QTY_smallint,
        CAST(mid.NEW_BUFFER_DUR AS INT) AS NEW_BUFFER_DUR_smallint,
        CAST(mid.NEW_STD_WORKING_DUR AS INT) AS NEW_STD_WORKING_DUR_smallint,
        CAST(mid.NEW_TOW_TIME_DUR AS INT) AS NEW_TOW_TIME_DUR_smallint,
        mid.NEW_FIXED_LINK_RSN_TXT,

        /* Effective/expiry dates */
        TO_TIMESTAMP('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>','DDMONYY') AS NEW_LINK_EFFECTIVE_DT,
        TO_TIMESTAMP('31122050','DDMMYYYY') AS NEW_LINK_EXPIRY_DT,
        'Y' AS NEW_CURRENT_REC_IND
    FROM mid
)
SELECT *
FROM final;

-- SFX-16: Snowflake Scripting block (LET/IF/RAISE) and COMMIT commented out for
