        (
            IFNULL(n.IN_ARR_GMT_FLT_DT,'') ||
            IFNULL(TO_CHAR(n.IN_ARR_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(n.IN_PAX_TML_CD,'') ||
            IFNULL(n.IN_GROUND_ACY_CD,'') ||
            IFNULL(n.IN_SERVICE_TYP,'') ||
            IFNULL(n.OUT_DESTN_STN_CD,'') ||
            IFNULL(n.OUT_ALN_CD,'') ||
            IFNULL(RTRIM(n.OUT_FLT_NO),'') ||
            IFNULL(n.OUT_FLT_SFX_CD,'') ||
            IFNULL(n.OUT_DEP_GMT_FLT_DT,'') ||
            IFNULL(TO_CHAR(n.OUT_DEP_GMT_FLT_TM,'HH24MI'),'') ||
            IFNULL(n.OUT_ARR_GMT_FLT_DT,'') ||
            IFNULL(n.OUT_PAX_TML_CD,'') ||
            IFNULL(n.OUT_GROUND_ACY_CD,'') ||
            IFNULL(n.OUT_SERVICE_TYP,'') ||
            IFNULL(n.AIRCRAFT_OWNER_CD,'') ||
            IFNULL(n.CARRIER_AC_TYP,'') ||
            IFNULL(RTRIM(n.MIDNIGHT_QTY),'') ||
            IFNULL(RTRIM(n.BUFFER_DUR),'') ||
            IFNULL(RTRIM(n.STD_WORKING_DUR),'') ||
            IFNULL(RTRIM(n.TOW_TIME_DUR),'') ||
            IFNULL(n.FIXED_LINK_RSN_TXT,'')
        ) AS NEW_concat_record
    FROM old_links o
    FULL OUTER JOIN new_links n
      ON n.LINK_STN_CD     = o.LINK_STN_CD
     AND n.IN_ORIGN_STN_CD = o.IN_ORIGN_STN_CD
     AND n.IN_ALN_CD       = o.IN_ALN_CD
     AND n.IN_FLT_NO       = o.IN_FLT_NO_STR
     AND n.IN_FLT_SFX_CD   = o.IN_FLT_SFX_CD
     AND n.IN_DEP_GMT_FLT_DT = o.IN_DEP_DT_STR
),
filtered AS (
    SELECT *
    FROM joined
    WHERE
        /* Same nested IFF logic, simplified */
        (
            NEW_LINK_STN_CD IS NULL
            AND OLD_LINK_EXPIRY_DT = TO_TIMESTAMP('31122050','DDMMYYYY')
        )
        OR OLD_LINK_STN_CD IS NULL
        OR OLD_concat_record <> NEW_concat_record
        OR (
            OLD_concat_record = NEW_concat_record
            AND OLD_LINK_EXPIRY_DT <> TO_TIMESTAMP('31122050','DDMMYYYY')
        )
)
SELECT *
FROM filtered;

CREATE OR REPLACE TRANSIENT TABLE STAGING.ExpFinalyseInserts AS
-- SFX-18: restructured into a CTE chain (base -> mid -> final) so SELECT-list
-- aliases (v_IN_FLT_LEG_SEQ_NO, v_OUT_FLT_LEG_SEQ_NO, NEW_IN_FLT_LEG_SEQ_NO,
-- NEW_OUT_FLT_LEG_SEQ_NO) are real columns in their own scope rather than
-- forward references within one SELECT list (invalid on Snowflake).
WITH base AS (
    SELECT
        r.*,
        /* Inbound leg sequence logic */
        IFF(
            TRIM(r.NEW_IN_ALN_CD) <> 'BA',
            0,
            IFF(
                r.Action_code = 'I',  -- TODO(SME): Action_code not projected by joined/filtered; confirm source column in Rtr_DirectFlowOfLinksRecords.
                inlk.FLT_LEG_SEQ_NO,
                r.OLD_IN_FLT_LEG_SEQ_NO
            )
        ) AS v_IN_FLT_LEG_SEQ_NO,

        /* Outbound leg sequence logic */
        IFF(
            TRIM(r.NEW_OUT_ALN_CD) <> 'BA',
            0,
            IFF(
                r.Action_code = 'B',  -- TODO(SME): Action_code not projected by joined/filtered; confirm source column in Rtr_DirectFlowOfLinksRecords.
                IFF(
                    (
                        r.OLD_OUT_ALN_CD = r.NEW_OUT_ALN_CD
                        AND r.OLD_OUT_FLT_NO = CAST(r.NEW_OUT_FLT_NO AS INT)
                        AND r.OLD_OUT_FLT_SFX_CD = r.NEW_OUT_FLT_SFX_CD
                        AND r.OLD_OUT_DEP_GMT_FLT_DT = TRY_TO_TIMESTAMP(r.NEW_OUT_DEP_GMT_FLT_DT,'DDMONYY')
                        AND r.OLD_LINK_STN_CD = r.NEW_LINK_STN_CD
                        AND r.OLD_OUT_DESTN_STN_CD = r.NEW_OUT_DESTN_STN_CD
                    ),
                    r.OLD_OUT_FLT_LEG_SEQ_NO,
                    outlk.FLT_LEG_SEQ_NO
                ),
                outlk.FLT_LEG_SEQ_NO
            )
        ) AS v_OUT_FLT_LEG_SEQ_NO
    FROM STAGING.Rtr_DirectFlowOfLinksRecords r
    LEFT JOIN STAGING.Lkp_InFltLegSeqNo inlk
        ON inlk.OPERATING_AIRLINE_CD = r.NEW_IN_ALN_CD
       AND inlk.OPERATING_FLT_NO     = CAST(r.NEW_IN_FLT_NO AS INT)
       AND inlk.OPERATING_SFX_CD     = r.NEW_IN_FLT_SFX_CD
       AND inlk.GMT_SCHED_ARR_TM     = r.NEW_IN_ARR_GMT_FLT_TM
       AND inlk.DEP_STN_CD           = r.NEW_IN_ORIGN_STN_CD
       AND inlk.ARR_STN_CD           = r.NEW_LINK_STN_CD

    LEFT JOIN STAGING.Lkp_OutFltLegSeqNo outlk  -- TODO(SME): Lkp_OutFltLegSeqNo is never created in this file; confirm it is built by a sibling script and that GMT_SCHED_DEP_TM is its departure-time column.
        ON outlk.OPERATING_AIRLINE_CD = r.NEW_OUT_ALN_CD
       AND outlk.OPERATING_FLT_NO     = CAST(r.NEW_OUT_FLT_NO AS INT)
       AND outlk.OPERATING_SFX_CD     = r.NEW_OUT_FLT_SFX_CD
       AND outlk.GMT_SCHED_DEP_TM     = r.NEW_OUT_DEP_GMT_FLT_TM
       AND outlk.DEP_STN_CD           = r.NEW_LINK_STN_CD
       AND outlk.ARR_STN_CD           = r.NEW_OUT_DESTN_STN_CD

    WHERE r.Action_code IN ('I','B')  -- TODO(SME): Action_code not projected by joined/filtered; confirm source column in Rtr_DirectFlowOfLinksRecords.
),
mid AS (
    SELECT
        base.*,
        /* Inbound leg sequence boundary validation */
        IFF(
            v_IN_FLT_LEG_SEQ_NO IS NULL,
            IFF(
                NEW_IN_ARR_GMT_FLT_DT IN (
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                ),
                v_IN_FLT_LEG_SEQ_NO,
                NULL
            ),
            v_IN_FLT_LEG_SEQ_NO
        ) AS NEW_IN_FLT_LEG_SEQ_NO,

        /* Outbound boundary validation */
        IFF(
            v_OUT_FLT_LEG_SEQ_NO IS NULL,
            IFF(
                NEW_OUT_DEP_GMT_FLT_DT IN (
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_start %>',
                    '<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Period_end %>'
                ),
                v_OUT_FLT_LEG_SEQ_NO,
                NULL
            ),
            v_OUT_FLT_LEG_SEQ_NO
        ) AS NEW_OUT_FLT_LEG_SEQ_NO
    FROM base
)
SELECT
    /* Basic inbound fields */
    NEW_LINK_STN_CD,
    NEW_IN_ORIGN_STN_CD,
    NEW_IN_ALN_CD,
    CAST(NEW_IN_FLT_NO AS INT) AS NEW_IN_FLT_NO_smallint,
    NEW_IN_FLT_SFX_CD,
    TO_DATE(NEW_IN_DEP_GMT_FLT_DT,'DDMONYY') AS NEW_IN_DEP_GMT_FLT_DT_date,
    TO_DATE(NEW_IN_ARR_GMT_FLT_DT,'DDMONYY') AS NEW_IN_ARR_GMT_FLT_DT_date,
    NEW_IN_ARR_GMT_FLT_TM AS NEW_IN_ARR_GMT_FLT_TM_date,
    NEW_IN_PAX_TML_CD,
    NEW_IN_GROUND_ACY_CD,
    NEW_IN_SERVICE_TYP,

    /* Inbound leg sequence logic */
    v_IN_FLT_LEG_SEQ_NO,
    NEW_IN_FLT_LEG_SEQ_NO,

    /* Outbound fields */
    NEW_OUT_DESTN_STN_CD,
    NEW_OUT_ALN_CD,
    CAST(NEW_OUT_FLT_NO AS INT) AS NEW_OUT_FLT_NO_smallint,
    NEW_OUT_FLT_SFX_CD,
    TO_DATE(NEW_OUT_DEP_GMT_FLT_DT,'DDMONYY') AS NEW_OUT_DEP_GMT_FLT_DT_date,
    NEW_OUT_DEP_GMT_FLT_TM AS NEW_OUT_DEP_GMT_FLT_TM_date,
    TO_DATE(NEW_OUT_ARR_GMT_FLT_DT,'DDMONYY') AS NEW_OUT_ARR_GMT_FLT_DT_date,
    NEW_OUT_ARR_GMT_FLT_TM AS NEW_OUT_ARR_GMT_FLT_TM_date,  -- [DEF-07] was NEW_OUT_DEP_GMT_FLT_TM; corrected to arrival time. -- TODO(SME): confirm.
    NEW_OUT_PAX_TML_CD,
    NEW_OUT_GROUND_ACY_CD,
    NEW_OUT_SERVICE_TYP,

    /* Outbound leg sequence logic */
    v_OUT_FLT_LEG_SEQ_NO,
    NEW_OUT_FLT_LEG_SEQ_NO,

    /* Outbound error message */
    IFF(
        NEW_OUT_FLT_LEG_SEQ_NO IS NULL,
        '#################### ATTENTION! The link record with the following onward flight key does not exist on FLT_SCHEDULE_SALES: OUT_ALN_CD="' ||
        NEW_OUT_ALN_CD || '", OUT_FLT_NO="' || NEW_OUT_FLT_NO || '", OUT_FLT_SFX_CD="' || NEW_OUT_FLT_SFX_CD ||
        '", OUT_DEP_GMT_FLT_DT="' || NEW_OUT_DEP_GMT_FLT_DT || '", OUT_DEP_GMT_FLT_TM="' || NEW_OUT_DEP_GMT_FLT_TM ||
        '", LINK_STN_CD="' || NEW_LINK_STN_CD || '", OUT_DESTN_STN_CD="' || NEW_OUT_DESTN_STN_CD || '" ####################',
        'N'
    ) AS v_AbortSessionBecauseOfNULLOutFltLegSeqNo,

    /* Inbound error message */
    -- TODO(SME): this message reuses NEW_OUT_DEP_GMT_FLT_TM for IN_DEP_GMT_FLT_TM and
    -- NEW_OUT_DESTN_STN_CD for IN_DESTN_STN_CD (suspected copy-paste from the outbound
    -- message). Left as-is: message text is cosmetic, not logic; per DEF-07 do not guess.
    IFF(
        NEW_IN_FLT_LEG_SEQ_NO IS NULL,
        '#################### ATTENTION! The link record with the following inbound flight key does not exist on FLT_SCHEDULE_SALES: IN_ALN_CD="' ||
        NEW_IN_ALN_CD || '", IN_FLT_NO="' || NEW_IN_FLT_NO || '", IN_FLT_SFX_CD="' || NEW_IN_FLT_SFX_CD ||
        '", IN_DEP_GMT_FLT_DT="' || NEW_IN_DEP_GMT_FLT_DT || '", IN_DEP_GMT_FLT_TM="' || NEW_OUT_DEP_GMT_FLT_TM ||
        '", LINK_STN_CD="' || NEW_LINK_STN_CD || '", IN_DESTN_STN_CD="' || NEW_OUT_DESTN_STN_CD || '" ####################',
        'N'
    ) AS v_AbortSessionBecauseOfNULLInFltLegSeqNo,

    /* Remaining fields */
    NEW_AIRCRAFT_OWNER_CD,
    NEW_CARRIER_AC_TYP,
    CAST(NEW_MIDNIGHT_QTY AS INT) AS NEW_MIDNIGHT_QTY_smallint,
    CAST(NEW_BUFFER_DUR AS INT) AS NEW_BUFFER_DUR_smallint,
    CAST(NEW_STD_WORKING_DUR AS INT) AS NEW_STD_WORKING_DUR_smallint,
    CAST(NEW_TOW_TIME_DUR AS INT) AS NEW_TOW_TIME_DUR_smallint,
    NEW_FIXED_LINK_RSN_TXT,

    /* Effective/expiry dates */
    TO_TIMESTAMP('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>','DDMONYY') AS NEW_LINK_EFFECTIVE_DT,
    TO_TIMESTAMP('31122050','DDMMYYYY') AS NEW_LINK_EXPIRY_DT,
    'Y' AS NEW_CURRENT_REC_IND
FROM mid;

-- SFX-16: Snowflake Scripting constructs (LET / IF ... THEN / RAISE EXC) are
-- only valid inside an anonymous block; wrap them in BEGIN ... END;.
BEGIN
    LET err_text VARCHAR := (
        SELECT ANY_VALUE(err_text)
        FROM (
            SELECT v_AbortSessionBecauseOfNULLOutFltLegSeqNo AS err_text
            FROM STAGING.ExpFinalyseInserts
            UNION ALL
            SELECT v_AbortSessionBecauseOfNULLInFltLegSeqNo AS err_text
            FROM STAGING.ExpFinalyseInserts
        )
        WHERE err_text <> 'N'
    );

    IF (err_text IS NOT NULL) THEN
        SYSTEM$LOG_ERROR(err_text);
        LET EXC EXCEPTION := EXCEPTION(-20002, err_text);
        RAISE EXC;
    END IF;
END;

COMMIT;

