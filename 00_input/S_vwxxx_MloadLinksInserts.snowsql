 INSERT INTO BASE.FLT_FOLDER_LINKS (
    LINK_STATION_CD,
    IN_ORIGN_STATION_CD,
    IN_ALN_CD,
    IN_FLT_NO,
    IN_FLT_SFX_CD,
    IN_DEP_FLTDT,
    IN_ARR_FLTDT,
    IN_ARR_FLTTM,
    IN_PAX_TML_CD,
    IN_GROUND_ACY_CD,
    IN_SERVICE_TYP,
    IN_FLT_LEG_SEQ_NO,
    OUT_DESTATION_STATION_CD,
    OUT_ALN_CD,
    OUT_FLT_NO,
    OUT_FLT_SFX_CD,
    OUT_DEP_FLTDT,
    OUT_DEP_FLTTM,
    OUT_ARR_FLTDT,
    OUT_PAX_TML_CD,
    OUT_GROUND_ACY_CD,
    OUT_SERVICE_TYP,
    OUT_FLT_LEG_SEQ_NO,
    AIRCRAFT_OWNER_CD,
    CARRIER_AC_TYP,
    MIDNIGHT_QTY,
    BUFFER_DUR,
    STD_WORKING_DUR,
    TOW_TIME_DUR,
    FIXED_LINK_RSN_TXT,
    LINK_EFFECTIVE_DT,
    LINK_EXPIRY_DT,
    CURRENT_REC_IND
)
SELECT
    NEW_LINK_STATION_CD,
    NEW_IN_ORIGN_STATION_CD,
    NEW_IN_ALN_CD,
    NEW_IN_FLT_NO_SMALLINT,
    NEW_IN_FLT_SFX_CD,
    NEW_IN_DEP_FLTDT_DATE,
    NEW_IN_ARR_FLTDT_DATE,
    NEW_IN_ARR_FLTTM_DATE,
    NEW_IN_PAX_TML_CD,
    NEW_IN_GROUND_ACY_CD,
    NEW_IN_SERVICE_TYP,
    NEW_IN_FLT_LEG_SEQ_NO,
    NEW_OUT_DESTATION_STATION_CD,
    NEW_OUT_ALN_CD,
    NEW_OUT_FLT_NO_SMALLINT,
    NEW_OUT_FLT_SFX_CD,
    NEW_OUT_DEP_FLTDT_DATE,
    NEW_OUT_DEP_FLTTM_DATE,
    NEW_OUT_ARR_FLTDT_DATE,
    NEW_OUT_PAX_TML_CD,
    NEW_OUT_GROUND_ACY_CD,
    NEW_OUT_SERVICE_TYP,
    NEW_OUT_FLT_LEG_SEQ_NO,
    NEW_AIRCRAFT_OWNER_CD,
    NEW_CARRIER_AC_TYP,
    NEW_MIDNIGHT_QTY_SMALLINT,
    NEW_BUFFER_DUR_SMALLINT,
    NEW_STD_WORKING_DUR_SMALLINT,
    NEW_TOW_TIME_DUR_SMALLINT,
    NEW_FIXED_LINK_RSN_TXT,
    NEW_LINK_EFFECTIVE_DT,
    NEW_LINK_EXPIRY_DT,
    NEW_CURRENT_REC_IND
FROM STAGING.ExpFinalyseInserts S
WHERE S.IN_FLT_LEG_SEQ_NO IS NOT NULL
  AND S.OUT_FLT_LEG_SEQ_NO IS NOT NULL
  AND NOT EXISTS (
        SELECT 1
        FROM BASE.FLT_FOLDER_LINKS T
        WHERE T.LINK_STATION_CD = S.NEW_LINK_STATION_CD
          AND T.IN_ORIGN_STATION_CD = S.NEW_IN_ORIGN_STATION_CD
          AND T.IN_ALN_CD = S.NEW_IN_ALN_CD
          AND T.IN_FLT_NO = S.NEW_IN_FLT_NO_SMALLINT
          AND T.IN_FLT_SFX_CD = S.NEW_IN_FLT_SFX_CD
          AND T.IN_DEP_FLTDT = S.NEW_IN_DEP_FLTDT_DATE
          AND T.IN_ARR_FLTDT = S.NEW_IN_ARR_FLTDT_DATE
          AND T.IN_ARR_FLTTM = S.NEW_IN_ARR_FLTTM_DATE
          AND T.IN_PAX_TML_CD = S.NEW_IN_PAX_TML_CD
          AND T.IN_GROUND_ACY_CD = S.NEW_IN_GROUND_ACY_CD
          AND T.IN_SERVICE_TYP = S.NEW_IN_SERVICE_TYP
          AND T.IN_FLT_LEG_SEQ_NO = S.NEW_IN_FLT_LEG_SEQ_NO
          AND T.OUT_DESTATION_STATION_CD = S.NEW_OUT_DESTATION_STATION_CD
          AND T.OUT_ALN_CD = S.NEW_OUT_ALN_CD
          AND T.OUT_FLT_NO = S.NEW_OUT_FLT_NO_SMALLINT
          AND T.OUT_FLT_SFX_CD = S.NEW_OUT_FLT_SFX_CD
          AND T.OUT_DEP_FLTDT = S.NEW_OUT_DEP_FLTDT_DATE
          AND T.OUT_DEP_FLTTM = S.NEW_OUT_DEP_FLTTM_DATE
          AND T.OUT_ARR_FLTDT = S.NEW_OUT_ARR_FLTDT_DATE
          AND T.OUT_PAX_TML_CD = S.NEW_OUT_PAX_TML_CD
          AND T.OUT_GROUND_ACY_CD = S.NEW_OUT_GROUND_ACY_CD
          AND T.OUT_SERVICE_TYP = S.NEW_OUT_SERVICE_TYP
          AND T.OUT_FLT_LEG_SEQ_NO = S.NEW_OUT_FLT_LEG_SEQ_NO
          AND T.AIRCRAFT_OWNER_CD = S.NEW_AIRCRAFT_OWNER_CD
          AND T.CARRIER_AC_TYP = S.NEW_CARRIER_AC_TYP
          AND T.MIDNIGHT_QTY = S.NEW_MIDNIGHT_QTY_SMALLINT
          AND T.BUFFER_DUR = S.NEW_BUFFER_DUR_SMALLINT
          AND T.STD_WORKING_DUR = S.NEW_STD_WORKING_DUR_SMALLINT
          AND T.TOW_TIME_DUR = S.NEW_TOW_TIME_DUR_SMALLINT
          AND T.FIXED_LINK_RSN_TXT = S.NEW_FIXED_LINK_RSN_TXT
          AND T.LINK_EFFECTIVE_DT = S.NEW_LINK_EFFECTIVE_DT
          AND T.LINK_EXPIRY_DT = S.NEW_LINK_EXPIRY_DT
          AND T.CURRENT_REC_IND = S.NEW_CURRENT_REC_IND
    );

