    NEW_OUT_FLT_SFX_CD,
    NEW_OUT_DEP_FLTDT_DATE, -- TODO(SME) SEM-06/DTX-10: _DATE suffix = staging cast; confirm OUT_DEP_FLTDT type compatibility.
    NEW_OUT_DEP_FLTTM_DATE, -- TODO(SME) SEM-06/DTX-10 + SEM-04: _DATE suffix on a _TTM (time) slot; confirm staging cast + target type and timezone handling.
    NEW_OUT_ARR_FLTDT_DATE, -- TODO(SME) SEM-06/DTX-10: _DATE suffix = staging cast; confirm OUT_ARR_FLTDT type compatibility.
    NEW_OUT_PAX_TML_CD,
