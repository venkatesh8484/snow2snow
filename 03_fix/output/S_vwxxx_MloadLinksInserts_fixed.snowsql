    NEW_OUT_SERVICE_TYP,
    NEW_OUT_FLT_LEG_SEQ_NO,
    NEW_AIRCRAFT_OWNER_CD,
    NEW_CARRIER_AC_TYP,
    NEW_MIDNIGHT_QTY_SMALLINT, -- TODO(SME) SEM-06/DTX-10: _SMALLINT suffix = staging cast; confirm MIDNIGHT_QTY type compatibility.
    NEW_BUFFER_DUR_SMALLINT, -- TODO(SME) SEM-06/DTX-10: _SMALLINT suffix = staging cast; confirm BUFFER_DUR type compatibility.
    NEW_STD_WORKING_DUR_SMALLINT, -- TODO(SME) SEM-06/DTX-10: _SMALLINT suffix = staging cast; confirm STD_WORKING_DUR type compatibility.
    NEW_TOW_TIME_DUR_SMALLINT, -- TODO(SME) SEM-06/DTX-10: _SMALLINT suffix = staging cast; confirm TOW_TIME_DUR type compatibility.
    NEW_FIXED_LINK_RSN_TXT,
