    NEW_IN_ORIGN_STATION_CD,
    NEW_IN_ALN_CD,
    NEW_IN_FLT_NO_SMALLINT, -- TODO(SME) SEM-06/DTX-10: _SMALLINT suffix = staging cast, not target type; confirm IN_FLT_NO type compatibility vs BASE column.
