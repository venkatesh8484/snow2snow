-- SEM ▸ DEF-07 (table name): UPDATE target is FLT_FOLDERLINKS; the NOT EXISTS guard uses FLIGHT_FOLDERLINKS — confirm same table
UPDATE BASE.FLT_FOLDERLINKS tgt
SET
    LINK_EXPIRY_DT  = src.LINK_EXPIRY_DT,
    CURRENT_REC_IND = src.CURRENT_REC_IND
FROM (
    SELECT
        OLD_LINK_STATION_CD       AS LINK_STATION_CD,
        OLD_IN_ORIGN_STATION_CD   AS IN_ORIGN_STATION_CD,
        OLD_IN_ALN_CD         AS IN_ALN_CD,
        OLD_IN_FLIGHT_NO         AS IN_FLIGHT_NO,
        OLD_IN_FLIGHT_SFX_CD     AS IN_FLIGHT_SFX_CD,
        -- SEM ▸ DEF-07 (alias): renamed from IN_DEP_GMTFLIGHT_FLIGHT_DT to align with outer WHERE (line 31) and NOT EXISTS guard (line 38)
        OLD_IN_DEP_FLIGHT_DT AS IN_DEP_FLIGHT_DT,  -- [DEF-07] alias renamed from IN_DEP_GMTFLIGHT_FLIGHT_DT; TODO(SME): confirm grain
        OLD_LINK_EFFECTIVE_DT AS LINK_EFFECTIVE_DT,
        -- SEM ▸ SEM-08: IFF NULL path — TO_CHAR(NULL) or NULL ACTION_CODE falls to the false-branch; confirm intent
        IFF(  -- TODO(SME) SEM-08: NULL path in TO_CHAR/IFF falls to false-branch
            -- SEM ▸ SEM-08: if OLD_LINK_EXPIRY_DT is NULL, NULL <> '20501231' is NULL -> IFF false-branch (DATEADD)
            TO_CHAR(OLD_LINK_EXPIRY_DT,'YYYYMMDD') <> '20501231',
            OLD_LINK_EXPIRY_DT,
            -- SEM ▸ SNZ-01 template tag preserved verbatim; SEM-06: 'DDMONYY' locale-dependent MON mask
            DATEADD(DAY,-1,TO_DATE('<% ctx.env.S_vw6122_CompareLinksRecordsWithTeradata_Current_date %>','DDMONYY'))  -- [KEEP] SNZ-01; TODO(SME) SEM-06: locale mask
        ) AS LINK_EXPIRY_DT,
        -- SEM ▸ SEM-08: NULL ACTION_CODE -> '= U' is NULL -> IFF false-branch 'N'; confirm intent
        IFF(ACTION_CODE = 'U','Y','N') AS CURRENT_REC_IND  -- TODO(SME) SEM-08: NULL ACTION_CODE -> 'N'
    FROM STAGING.Rtr_DirectFlowOfLinksRecords
    -- SEM ▸ subquery filter keeps update/both records only
    WHERE ACTION_CODE IN ('U','B')
) src
-- SEM ▸ SEM-03/SEM-10: first of 7 join keys; CHAR(n) padding + grain confirmation needed
WHERE tgt.LINK_STATION_CD       = src.LINK_STATION_CD  -- TODO(SME) SEM-03/SEM-10: CHAR(n) padding + grain
  AND tgt.IN_ORIGN_STATION_CD   = src.IN_ORIGN_STATION_CD
  AND tgt.IN_ALN_CD         = src.IN_ALN_CD
  AND tgt.IN_FLIGHT_NO         = src.IN_FLIGHT_NO
  AND tgt.IN_FLIGHT_SFX_CD     = src.IN_FLIGHT_SFX_CD
  AND tgt.IN_DEP_FLIGHT_DT = src.IN_DEP_FLIGHT_DT
  AND tgt.LINK_EFFECTIVE_DT = src.LINK_EFFECTIVE_DT
  AND NOT EXISTS (
        SELECT 1
        -- SEM ▸ DEF-07 (table name): guard table name differs from UPDATE target — confirm same table
        FROM BASE.FLIGHT_FOLDERLINKS x  -- TODO(SME) DEF-07: same table as UPDATE target BASE.FLT_FOLDERLINKS?
        WHERE x.LINK_STATION_CD       = tgt.LINK_STATION_CD  -- TODO(SME) SEM-03: CHAR(n) padding
          AND x.IN_ORIGN_STATION_CD   = tgt.IN_ORIGN_STATION_CD
          AND x.IN_ALN_CD         = tgt.IN_ALN_CD
          AND x.IN_FLIGHT_NO         = tgt.IN_FLIGHT_NO
          AND x.IN_FLIGHT_SFX_CD     = tgt.IN_FLIGHT_SFX_CD
          AND x.IN_DEP_FLIGHT_DT = tgt.IN_DEP_FLIGHT_DT
          AND x.LINK_EFFECTIVE_DT = tgt.LINK_EFFECTIVE_DT
          AND x.LINK_EXPIRY_DT    = src.LINK_EXPIRY_DT
          AND x.CURRENT_REC_IND   = src.CURRENT_REC_IND
  );
